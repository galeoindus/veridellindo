# Veridellindo Pages Function local secrets.
# Copy to .dev.vars for `wrangler pages dev`. The Workers AI `AI` binding is
# configured separately in Cloudflare Pages; it is not a text secret.
# The current /api/chat Function reads only these OpenRouter key names.
# Provider/model selection is sent by the Amigo client and checked server-side.
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
OPENROUTER_API_KEY_4=
OPENROUTER_API_KEY_5=
OPENROUTER_API_KEY_6=
OPENROUTER_API_KEY_7=
OPENROUTER_API_KEY_8=
OPENROUTER_API_KEY_9=
OPENROUTER_API_KEY_10=
OPENROUTER_API_KEY_11=
OPENROUTER_API_KEY_12=
OPENROUTER_API_KEY=
