{
  "name": "veridell",
  "version": "6.10.54",
  "private": true,
  "type": "module",
  "description": "Veridellindo — a privacy-first Wikimedia research and discovery platform with Amigo multi-turn AI conversation, cited answers and local chat history.",
  "homepage": "https://veridellindo.pages.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/galeoindus/veridellindo.git"
  },
  "license": "MIT",
  "keywords": [
    "wikipedia",
    "wikidata",
    "knowledge",
    "search",
    "reader",
    "cloudflare-pages",
    "pwa"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "articles": "python3 scripts/gen_articles.py",
    "audit:deep": "node scripts/deep-audit.mjs",
    "audit:site": "node scripts/audit-site.mjs",
    "check": "node scripts/check.mjs && node scripts/audit-site.mjs",
    "check:browser": "node scripts/run-browser-check.mjs back-nav-check.mjs && node scripts/run-browser-check.mjs translate-check.mjs && node scripts/run-browser-check.mjs interaction-check.mjs && node scripts/run-browser-check.mjs site-smoke.mjs",
    "check:layout": "node scripts/run-browser-check.mjs amigo-layout-check.mjs",
    "check:site": "node scripts/run-browser-check.mjs site-sweep.mjs",
    "deploy": "node scripts/deploy.mjs",
    "dev": "npx --yes wrangler pages dev . --port 4173",
    "doctor": "node scripts/doctor.mjs",
    "doctor:full": "node scripts/doctor.mjs --full",
    "release": "node scripts/release.mjs",
    "serve": "python3 -m http.server 4173",
    "smoke": "node scripts/site-smoke.mjs",
    "stamp:build": "node scripts/stamp-build.mjs",
    "start": "python3 -m http.server 4173",
    "test": "node --test",
    "test:core": "node --test test/*.test.mjs",
    "verify": "npm run check && npm run test",
    "verify:live": "node scripts/post-deploy-check.mjs"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "sharp": "^0.35.5",
    "ws": "^8.23.0"
  }
}
